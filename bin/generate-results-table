#!/usr/bin/env -S java --source 25

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.Comparator;
import java.util.Map;
import java.util.TreeMap;

import static java.util.Map.entry;
import static java.util.stream.Collectors.joining;

/// Reads `results/all_results` (generated by run.sh) and prints the result in a Markdown table for the `README.md`.
/// One row per test, one column per JDK version.
/// Consecutive columns with the same results are merged into a single column (e.g. "12-14").
public class GenerateResultsTable {

  record Column(String label, Map<String, Result> testToResult) {}

  static void main(String[] args) throws Exception {
    List<Column> rawResults = readResults();
    switch (args[0]) {
      case "markdown": {
        List<Column> columns = merge(rawResults);
        printMarkdown(columns);
        break;
      }
      case "blog": {
        // Main test corresponding to method presented in the blog
        Map<String, String> methods = Map.ofEntries(
            entry("1: Reflection", "SetAccessible"),
            entry("2: Unsafe", "UnsafePut"),
            entry("3: JNI", "UseJNI"),
            entry("4: Java Agent", "AttachJavaAgent"),
            entry("5: FFM - Load a Library", "FfmLibrary"),
            entry("6: FFM - Use libjvm", "FfmLibJvm"),
            entry("7: FFM - Heap", "FfmHeap"),
            entry("8: FFM - Bytecode", "FfmBytecode"),
            entry("9: Memory manipulation through the OS", "ProcMemBytecode"),
            entry("10: Patch the JDK", "PatchJimage"),
            entry("11: newConstructorForSerialization", "CtorForSerialization"));
        // no ea version in this table
        List<Column> filtered = rawResults.stream().filter(c -> !c.label.contains("ea")).toList();
        // ignore irrelevant tests
        for (Column c : filtered) {
          c.testToResult().keySet().retainAll(methods.values());
        }
        List<Column> columns = merge(filtered);
        printHtml(columns, methods);
        break;
      }
      default:
        System.err.println("Usage: bin/generate-results-table [markdown|blog]");
    }
  }

  /// Read results from `results/all_results`
  private static List<Column> readResults() throws IOException {
    Map<String, Column> columns = new TreeMap<>();

    for (String line : Files.readAllLines(Path.of("results/all_results"))) {
      if (line.isBlank()) {
        continue;
      }
      String[] parts = line.trim().split("\\s+");
      String test = parts[0];
      String version = parts[1].split("-", 2)[0]; // strip e.g. "-64BitOOP" variant suffix
      Result result = Result.valueOf(parts[2]);
      columns.computeIfAbsent(version, v -> new Column(v, new TreeMap<>())).testToResult()
          .merge(test, result, (a, b) -> {
            if (!a.equals(b)) {
              throw new IllegalStateException("Conflicting results: " + line);
            }
            return a;
          });
    }
    return columns.values().stream().toList();
  }

  /// Merge consecutive columns with the same values
  private static List<Column> merge(List<Column> inColumns) {
    List<Column> merged = new ArrayList<>();
    for (var inColumn : inColumns) {
      if (!merged.isEmpty() && merged.getLast().testToResult().equals(inColumn.testToResult)) {
        Column prevColumn = merged.removeLast();
        String firstVersion = prevColumn.label().split("-", 2)[0];
        merged.add(new Column(firstVersion + "-" + inColumn.label, inColumn.testToResult()));
      } else {
        merged.add(inColumn);
      }
    }
    return merged;
  }

  private static void printMarkdown(List<Column> columns) {
    List<String> tests = columns.stream()
        .flatMap(column -> column.testToResult().keySet().stream())
        .distinct().sorted().toList();

    System.out.println(columns.stream().map(Column::label)
        .collect(joining(" | ", "| Test | ", " |")));
    System.out.println("|" + "---|".repeat(columns.size() + 1));
    for (String test : tests) {
      System.out.println(columns.stream().map(c -> c.testToResult().getOrDefault(test, Result.NA).symbol)
          .collect(joining(" | ", "| " + test + " | ", " |")));
    }
  }

  /// Print HTML table for us in the blog post.
  /// Similar to [#printMarkdown], but using the keys of `methods` as title in row headers, where the value is the
  /// test name.
  private static void printHtml(List<Column> columns, Map<String, String> methods) {
    List<String> titles = methods.keySet().stream()
        .sorted(Comparator.comparingInt(d -> Integer.parseInt(d.split(":", 2)[0])))
        .toList();

    System.out.println("<table>");
    System.out.println(columns.stream().map(Column::label)
        .collect(joining("</th><th>", "<tr><th>Method</th><th>", "</th></tr>")));
    for (String title : titles) {
      String test = methods.get(title);
      System.out.println(columns.stream().map(c -> c.testToResult().getOrDefault(test, Result.NA).html)
          .collect(joining("</td><td>", "<tr><td><a href=\"#m" + methodNumber(title) + "\">" + title + "</a></td><td>", "</td></tr>")));
    }
    System.out.println("</table>");
  }

  private static int methodNumber(String title) {
    return Integer.parseInt(title.split(":", 2)[0]);
  }

  enum Result {
    PASS("✔️", "&#x2714;&#xFE0F;"),
    WARNING("⚠️", "&#x26A0;&#xFE0F;"),
    FAIL("❌", "&#x274C;"),
    NA("", "");

    final String symbol;
    final String html;

    Result(String symbol, String html) {
      this.symbol = symbol;
      this.html = html;
    }
  }
}
